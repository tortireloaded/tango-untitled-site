---
/**
 * Header — minimal, sticky-on-scroll, no bloat.
 * On the home hero: transparent over the dark hero (variant="transparent").
 * Otherwise: clean, light, with the wordmark and a booking CTA at the right edge.
 */
const nav = [
  { label: "Home",         href: "/" },
  { label: "About",        href: "/about" },
  { label: "Classes",      href: "/classes" },
  { label: "Location",     href: "/location" },
];

interface Props { variant?: "default" | "transparent"; }
const { variant = "default" } = Astro.props;
const path = Astro.url.pathname;

const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---
<header class={`site-header variant-${variant}`}>
  <div class="container header-inner">
    <a href="/" class="brand naked" aria-label="Tango Untitled home">
      <span class="brand-en">Tango Untitled</span>
      <span class="brand-zh">無 題 探 戈</span>
    </a>
    <nav class="primary-nav" aria-label="Primary">
      <ul>
        {nav.map((n) => (
          <li>
            <a href={n.href} class:list={["naked", isActive(n.href) && "active"]} aria-current={isActive(n.href) ? "page" : undefined}>
              {n.label}
            </a>
          </li>
        ))}
      </ul>
      <a href="/book" class="btn book-btn">Book a Class</a>
    </nav>
    <button class="menu-btn" aria-label="Open menu" id="menuBtn">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="mobile-nav" id="mobileNav" hidden>
    <ul>
      {nav.map((n) => (
        <li><a href={n.href} class="naked">{n.label}</a></li>
      ))}
      <li><a href="/book" class="btn" style="margin-top:1.5rem;display:inline-block">Book a Class</a></li>
    </ul>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .site-header.variant-default {
    background: rgba(250, 250, 247, 0.85);
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }
  .site-header.variant-transparent {
    background: linear-gradient(to bottom, rgba(0,0,0,0.5) 0%, rgba(0,0,0,0) 100%);
    color: var(--paper);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    text-decoration: none;
    border: 0;
  }
  .brand-en {
    font-family: var(--serif);
    font-size: 1.35rem;
    letter-spacing: 0.01em;
  }
  .brand-zh {
    font-size: 0.78rem;
    letter-spacing: 0.4em;
    opacity: 0.7;
  }
  .variant-default .brand-en { font-weight: 500; }

  /* primary nav */
  .primary-nav {
    display: flex;
    align-items: center;
    gap: 2.2rem;
  }
  .primary-nav ul {
    display: flex;
    align-items: center;
    gap: 2.2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .primary-nav a {
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    border: 0;
    padding: 0.25rem 0;
    opacity: 0.78;
    transition: opacity .15s var(--ease);
  }
  .primary-nav a:hover { opacity: 1; }
  .primary-nav a.active { opacity: 1; }
  .primary-nav a.active::after {
    content: "";
    display: block;
    height: 1px;
    background: currentColor;
    margin-top: 0.25rem;
    opacity: 0.7;
  }
  .book-btn {
    padding: 0.55rem 1.15rem;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
  }
  .variant-transparent .book-btn {
    background: transparent;
    color: var(--paper);
    border: 1px solid rgba(250,250,247,0.5);
  }
  .variant-transparent .book-btn:hover { background: var(--paper); color: var(--ink); border-color: var(--paper); }

  .menu-btn { display: none; background: none; border: 0; padding: 0.5rem; cursor: pointer; }
  .menu-btn span {
    display: block;
    width: 22px;
    height: 1.5px;
    background: currentColor;
    margin: 4px 0;
    transition: transform .2s var(--ease);
  }

  .mobile-nav {
    background: var(--paper);
    color: var(--ink);
    border-top: 1px solid var(--line);
  }
  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 1.5rem var(--pad-x);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .mobile-nav li a { font-size: 1.4rem; font-family: var(--serif); }

  @media (max-width: 760px) {
    .primary-nav { display: none; }
    .menu-btn { display: block; }
  }
  @media (min-width: 761px) {
    .mobile-nav { display: none !important; }
  }

  /* When transparent + scrolled: snap to default look */
  :global(body.scrolled) .site-header.variant-transparent {
    background: rgba(250, 250, 247, 0.95);
    color: var(--ink);
  }
</style>

<script is:inline>
  // mobile menu
  const btn = document.getElementById('menuBtn');
  const panel = document.getElementById('mobileNav');
  btn?.addEventListener('click', () => {
    const isOpen = !panel.hasAttribute('hidden');
    if (isOpen) panel.setAttribute('hidden', '');
    else panel.removeAttribute('hidden');
    btn.setAttribute('aria-expanded', String(!isOpen));
  });

  // snap transparent header to default on scroll
  const onScroll = () => {
    const scrolled = window.scrollY > 80;
    document.body.classList.toggle('scrolled', scrolled);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
